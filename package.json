{
  "name": "worker-agent-cloud",
  "version": "2.0.0",
  "description": "Worker Agent.Cloud — Mission Control for AI-powered content networks. Research trends, create content, enforce governance, run channels, and learn from every result. Includes MCP client for connecting external Model Context Protocol servers.",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "dev:api": "npm --prefix server run dev",
    "dev:worker": "npm --prefix server run dev:worker",
    "dev:web": "npm --prefix client run dev",
    "typecheck": "npm --prefix server run typecheck && npm --prefix client run typecheck",
    "typecheck:server": "npm --prefix server run typecheck",
    "typecheck:client": "npm --prefix client run typecheck",
    "lint": "npm --prefix server run lint --if-present && npm --prefix client run lint --if-present",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "coverage": "vitest run --coverage && open coverage/index.html",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "build:docs": "npx vitepress build docs",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build",
    "validate:ci": "npm run typecheck && npm run lint && npm run test:coverage && npm run build",
    "validate:e2e": "npm run test:e2e",
    "validate:accessibility": "echo 'Run axe-core on browser'",
    "release": "npm run validate:ci && npm version ${{ args.version }} && git push && git push --tags",
    "db:push": "npx drizzle-kit push",
    "db:generate": "npx drizzle-kit generate",
    "start:api": "npm --prefix server start:api",
    "start:worker": "npm --prefix server start:worker",
    "local:infra": "docker compose up -d mysql redis minio",
    "docker:build": "docker build -t worker-agent-cloud:latest .",
    "docker:push": "docker push workeragentcloud/worker-agent-cloud:latest",
    "docs:dev": "npx vitepress dev docs",
    "docs:build": "npx vitepress build docs",
    "e2e:install": "npx playwright install-deps chromium firefox webkit"
  },
  "keywords": [
    "ai-agents",
    "content-automation",
    "ai-content",
    "youtube-api",
    "tiktok-api",
    "multi-platform",
    "workflow-engine",
    "ai-workflow",
    "model-context-protocol",
    "mcp-client",
    "research-automation",
    "video-generation",
    "seo-automation",
    "social-media-publishing",
    "agentic-system",
    "video-processing",
    "ai-assistant",
    "llm-agents"
  ],
  "author": "Worker Agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cyberteckmaster/Worker-Agent.git"
  },
  "homepage": "https://workeragent.cloud",
  "bugs": {
    "url": "https://github.com/Cyberteckmaster/Worker-Agent/issues"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "drizzle-kit": "^0.23.5",
    "sitemap": "^7.1.0",
    "vitest": "^4.1.10",
    "vitest-coverage-merge": "^2.0.5",
    "vitest-coverage-webapp": "^0.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
