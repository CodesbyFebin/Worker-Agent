{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env _core/index.ts",
    "dev:api": "tsx watch --env-file=../.env _core/index.ts",
    "dev:worker": "tsx watch --env-file=../.env _core/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --env-file=../.env dist/server/_core/index.js",
    "start:api": "node --env-file=../.env dist/server/_core/index.js",
    "start:worker": "node --env-file=../.env dist/server/_core/worker.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "@aws-sdk/client-s3": "^3.1103.0",
    "@octokit/rest": "^21.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@trpc/server": "^10.45.2",
    "bullmq": "^6.1.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "ioredis": "^5.4.1",
    "mysql2": "^3.11.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "superjson": "^2.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
