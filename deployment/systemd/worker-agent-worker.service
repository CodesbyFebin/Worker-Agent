[Unit]
Description=Worker Agent Cloud — Background Worker (AI Agents & Pipelines)
Documentation=https://workeragent.cloud/docs
After=network.target postgresql.service redis.service worker-agent-api.service

[Service]
Type=simple
User=worker-agent
Group=worker-agent
WorkingDirectory=/opt/worker-agent/server
EnvironmentFile=/opt/worker-agent/deployment/rc1/env.template

ExecStart=/usr/bin/node /opt/worker-agent/server/dist/worker.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

# Resource limits
MemoryMax=4G
CPUQuota=400%
TasksMax=1024

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/worker-agent/server/logs /tmp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
