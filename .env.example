# Server
DATABASE_URL=mysql://root:@localhost:3306/worker_agent_cloud
ANTHROPIC_API_KEY=
PORT=4000
NODE_ENV=development

# LLM routing (OpenRouter Free recommended for God Machine)
# Providers: auto | ollama | openrouter | nvidia | pollinations | groq | gemini | anthropic
LLM_PROVIDER=openrouter
# OpenRouter Free router — picks an available :free model
LLM_MODEL=openrouter/free
LLM_FALLBACK=openrouter,ollama,nvidia,pollinations,groq,gemini,anthropic
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Free / freemium cloud keys
# OpenRouter — https://openrouter.ai/keys — base https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# NVIDIA NIM — https://build.nvidia.com — key starts with nvapi-
# Curated God Machine models: minimaxai/minimax-m3, poolside/laguna-xs-2.1,
# moonshotai/kimi-k2.6, z-ai/glm-5.2 (enable each model on your NGC account)
NVIDIA_API_KEY=
# Optional per-model keys JSON: {"minimaxai/minimax-m3":"nvapi-…",...}
NVIDIA_MODEL_KEYS=
GROQ_API_KEY=
GEMINI_API_KEY=
POLLINATIONS_API_KEY=

# Durable job queue (BullMQ)
REDIS_URL=redis://127.0.0.1:6380

GOD_MACHINE_REPO_ROOT=

TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

VITE_API_URL=http://localhost:4000/trpc
