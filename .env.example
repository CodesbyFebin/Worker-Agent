# ============================================================
# Worker Agent Cloud — Environment Configuration Template
# Copy this to .env.local / .env.production and fill in values.
# Never commit real credentials.
# ============================================================

# --- Application ---
NEXT_PUBLIC_APP_NAME=Worker Agent Cloud
NEXT_PUBLIC_APP_URL=https://workeragent.cloud
NEXT_PUBLIC_ENV=production

# --- Backend API ---
PORT=3001
HOST=0.0.0.0
BETTER_AUTH_SECRET=change-this-to-a-long-random-string-in-production

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/worker_agent

# --- Redis (rate limiting, queues) ---
REDIS_URL=redis://localhost:6379

# --- AI Provider API Keys ---
# Primary model providers (pick at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=

# Specialised providers
ELEVENLABS_API_KEY=
E_LEVENLABS_DEFAULT_VOICE_ID=
POLLINATIONS_API_KEY=
STABILITY_API_KEY=

# --- Search / Data Providers ---
TAVILY_API_KEY=
SERPAPI_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# --- OAuth Providers ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# --- Storage (S3-compatible) ---
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=

# --- Webhooks ---
WEBHOOK_SECRET=

# --- Logging ---
LOG_LEVEL=info

# --- Observability ---
NEXT_PUBLIC_SENTRY_DSN=

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
