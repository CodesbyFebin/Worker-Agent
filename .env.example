# ============================================================
# Worker Agent Cloud — Environment Configuration Template
# Copy to .env.local / .env.production and fill in values.
# Never commit real credentials.
#
# Authoritative contract: server/_core/env.ts (Zod-validated)
# Database: MySQL via DATABASE_URL (Drizzle ORM mysql2 adapter)
# ============================================================

# ─── DATABASE (MySQL — matches drizzle.config.ts dialect: mysql) ─
DATABASE_URL=mysql://root:password@localhost:3306/worker_agent_cloud

# ─── SERVER ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── LLM PROVIDER ────────────────────────────────────────────
# auto | anthropic | ollama | openrouter | nvidia | groq | gemini | pollinations
LLM_PROVIDER=auto
LLM_MODEL=
# Comma-separated fallback order when LLM_PROVIDER=auto
LLM_FALLBACK=ollama,openrouter,nvidia,pollinations,groq,gemini,anthropic
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ─── PROVIDER CREDENTIALS ──────────────────────────────────────
# Required only when LLM_PROVIDER=<that provider>
ANTHROPIC_API_KEY=sk-your-anthropic-key-here
OPENROUTER_API_KEY=sk-your-openrouter-key-here
NVIDIA_API_KEY=nvapi-your-nvidia-key-here
GROQ_API_KEY=gs-your-groq-key-here
GEMINI_API_KEY=your-gemini-key-here
POLLINATIONS_API_KEY=your-pollinations-key-here

# ─── RESEARCH LANE ───────────────────────────────────────────
TAVILY_API_KEY=your-tavily-key-here
BRAVE_SEARCH_API_KEY=your-brave-search-key-here
SERPER_API_KEY=your-serper-key-here

# ─── CACHE & QUEUE ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── PYTHON BRIDGE (FastAPI) ─────────────────────────────────
PYTHON_API_URL=http://localhost:8000
PYTHON_QUEUE_PREFIX=

# ─── GITHUB INTEGRATION ──────────────────────────────────────
GITHUB_TOKEN=ghp-your-github-token-here
GITHUB_REPO=CodesbyFebin/Worker-Agent
GITHUB_BASE_BRANCH=main

# ─── GOD MACHINE ─────────────────────────────────────────────
GOD_MACHINE_REPO_ROOT=/path/to/local/checkout

# ─── S3 / OBJECT STORAGE ─────────────────────────────────────
# Leave empty for local filesystem backend.
S3_ENDPOINT=s3.us-east-002.backblazeb2.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-s3-key-here
S3_SECRET_ACCESS_KEY=your-s3-secret-here
S3_BUCKET=worker-agent-artifacts
S3_FORCE_PATH_STYLE=
ARTIFACTS_LOCAL_DIR=./local-artifacts

# ─── CONTENT DISTRIBUTION ────────────────────────────────────
YOUTUBE_API_KEY=your-youtube-data-api-key-here
YOUTUBE_ACCESS_TOKEN=your-youtube-oauth-token-here
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx
TIKTOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
TWITTER_BEARER_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=
BLOGGER_API_KEY=
BLOGGER_BLOG_ID=

# ─── MEDIA / TTS ─────────────────────────────────────────────
PEXELS_API_KEY=your-pexels-key-here
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=your-cartesia-key-here

# ─── COST TRACKING ───────────────────────────────────────────
PRICE_PER_MILLION_INPUT_TOKENS_USD=0
PRICE_PER_MILLION_OUTPUT_TOKENS_USD=0

# ─── OBSERVABILITY (OpenTelemetry) ───────────────────────────
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=worker-agent-api
