# ============================================================
# CC-OS / Worker Agent — Environment Configuration Template
# Copy this to .env and fill in your values.
# Never commit real credentials.
# ============================================================

# ─── OPENAI ──────────────────────────────────────────────────
# Used as an optional premium/default model and research fallback.
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-5
OPENAI_RESEARCH_MODEL=gpt-5
OPENAI_FALLBACK_MODEL=gpt-5-mini

# ─── KILO ROUTER / FREE CLOUD PROVIDERS ──────────────────────
# Speed / governance fallback. Current quotas are provider-managed and dynamic.
GROQ_API_KEY=

# Research lane. Gemini 3.6 Flash supports Google Search grounding.
GEMINI_API_KEY=

# Free cloud fallback. Current OpenRouter free-plan limits are dynamic.
OPENROUTER_API_KEY=

# Optional local Ollama configuration. The local API normally requires no key.
# If Worker Agent runs on the same machine as Ollama, localhost works directly.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# ─── ELEVENLABS TTS ──────────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_DEFAULT_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ─── YOUTUBE DATA API v3 ─────────────────────────────────────
YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback

CHANNEL_01_REFRESH_TOKEN=
CHANNEL_01_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx
CHANNEL_02_REFRESH_TOKEN=
CHANNEL_02_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx
CHANNEL_03_REFRESH_TOKEN=
CHANNEL_03_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx
CHANNEL_04_REFRESH_TOKEN=
CHANNEL_04_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx
CHANNEL_05_REFRESH_TOKEN=
CHANNEL_05_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx
CHANNEL_06_REFRESH_TOKEN=
CHANNEL_06_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx
CHANNEL_07_REFRESH_TOKEN=
CHANNEL_07_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx
CHANNEL_08_REFRESH_TOKEN=
CHANNEL_08_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx
CHANNEL_09_REFRESH_TOKEN=
CHANNEL_09_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx
CHANNEL_10_REFRESH_TOKEN=
CHANNEL_10_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx

# ─── GOOGLE TRENDS / SERPAPI ─────────────────────────────────
SERPAPI_KEY=your-serpapi-key-here
GOOGLE_TRENDS_GEO=US

# ─── PEXELS / UNSPLASH / RAPID ───────────────────────────────
PEXELS_API_KEY=your-pexels-key-here
UNSPLASH_ACCESS_KEY=your-unsplash-key-here
RAPIDAPI_KEY=your-rapidapi-key-here

# ─── DATABASE ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ccos
DB_USER=root
DB_PASSWORD=

# ─── SYSTEM SETTINGS ────────────────────────────────────────
TOTAL_CHANNELS=10
QUEUE_INTERVAL_MINUTES=30
MAX_VIDEOS_PER_DAY=3
MIN_UPLOAD_GAP_HOURS=4
SELF_IMPROVEMENT_ENABLED=true
AB_TEST_WINDOW_HOURS=48
RAPID_PIVOT_THRESHOLD=0.4
HUMAN_NOISE_LEVEL=medium

# ─── PYTHON BRIDGE ──────────────────────────────────────────
PYTHON_API_URL=http://localhost:8000
PYTHON_QUEUE_PREFIX=

# ─── LOGGING / PATHS ────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
OUTPUT_DIR=./output
ASSETS_DIR=./assets
PROMPTS_DIR=./src/prompts
